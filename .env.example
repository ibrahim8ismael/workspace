# Local application settings. No services are started by installation.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
APP_ORIGIN=http://localhost:5173
# Backend auth requires a transaction-capable MongoDB replica set.
# Provision indexes with pnpm db:indexes before starting the API.
MONGODB_URI=mongodb://127.0.0.1:27017/gather_lite?replicaSet=rs0
REDIS_CACHE_URL=redis://127.0.0.1:6379
REDIS_QUEUE_URL=redis://127.0.0.1:6380
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Configure all three LiveKit values together; production LIVEKIT_URL must use wss://.
# API ↔ media guard HMAC key (32 random bytes, canonical base64). Blank keeps policy routes fail-closed.
MEDIA_MACHINE_KEY=

# Generate once with: openssl rand -base64 32
# Keep the key stable across API/worker restarts and protect it outside Git.
OUTBOX_ENCRYPTION_KEY=
# Optional local-development index provisioning; prohibited in production.
DB_AUTO_INDEX=false
# Only required when explicitly starting the mail worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
