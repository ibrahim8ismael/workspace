# Private local Compose settings. Do not use this file directly: the encryption
# key placeholder is intentionally invalid. Generate infra/.env.local with:
#   node infra/init-local-env.mjs
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
APP_ORIGIN=https://localhost:8443
MONGODB_URI=mongodb://mongo:27017/gather_lite?replicaSet=rs0
# Optional disposable cache profile; the current API does not use it.
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379
DB_AUTO_INDEX=false
OUTBOX_ENCRYPTION_KEY=__GENERATE_ON_INIT__

# Compose overrides these values to keep mail inside the local sink.
# The worker uses NODE_ENV=development only to allow plaintext SMTP to Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gather.local
