{
  "name": "@gather/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm build && node --watch --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@gather/delivery": "workspace:*",
    "bullmq": "6.7.0",
    "ioredis": "6.0.0",
    "mongoose": "9.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gather/tooling": "workspace:*",
    "typescript": "6.0.3",
    "@types/node": "24.19.2"
  }
}
