{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://localhost:8443 {
	tls internal
	encode zstd gzip

	@private_api path /api/internal /api/internal/* /api/media/internal /api/media/internal/*
	handle @private_api {
		respond 404
	}

	@livekit path /rtc /rtc/*
	handle @livekit {
		reverse_proxy media-guard:7885 {
			header_up Origin {http.request.header.Origin}
		}
	}

	@socketio path /socket.io /socket.io/*
	handle @socketio {
		reverse_proxy api:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
		}
	}

	handle {
		root * /srv
		header {
			# React uses inline style attributes; the app also supports user-configured HTTPS link embeds.
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://localhost:8443; media-src 'self' blob:; frame-src https:"
			X-Frame-Options "DENY"
		}
		route {
			try_files {path} /index.html
			@html path / /index.html
			header @html Cache-Control "no-cache, no-store, must-revalidate"
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
