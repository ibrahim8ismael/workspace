{
  "name": "gather-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @gather/web --filter @gather/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @gather/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @gather/api dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @gather/worker dev",
    "build:packages": "pnpm -r --filter \"./packages/**\" --if-present build",
    "build": "pnpm -r --if-present build",
    "build:commons": "pnpm --filter @gather/world build && pnpm --filter @gather/contracts build && node scripts/commons-assets-cli.mjs",
    "check:commons": "pnpm --filter @gather/world build && pnpm --filter @gather/contracts build && node scripts/commons-assets-cli.mjs --check",
    "test:commons": "node --test scripts/commons-assets.test.mjs",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm test:world && pnpm test:media-spike && pnpm check:commons && pnpm test:commons && pnpm test:shared && pnpm test:web && pnpm test:api && pnpm build",
    "clean": "node scripts/clean.mjs",
    "test:shared": "pnpm --filter @gather/legacy-shared test",
    "test:web": "pnpm exec vitest run --config apps/web/vitest.config.ts",
    "test:e2e": "pnpm exec playwright test",
    "test:api": "pnpm build:packages && pnpm --filter @gather/worker build && pnpm --filter @gather/api test",
    "test:e2e:live": "LIVE_OFFICE_E2E=1 pnpm exec playwright test tests/e2e/live-office.spec.ts",
    "db:indexes": "pnpm build:packages && pnpm --filter @gather/api db:indexes",
    "test:contracts": "pnpm --filter @gather/contracts test",
    "test:world": "pnpm --filter @gather/world test",
    "test:media-spike": "node --test spikes/media-enforcement/test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
